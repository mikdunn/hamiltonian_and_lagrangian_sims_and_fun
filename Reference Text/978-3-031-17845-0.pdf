                           <pdfaProperty:description>Name of the preflight profile used</pdfaProperty:description>
                           <pdfaProperty:name>profile_name</pdfaProperty:name>
                           <pdfaProperty:valueType>Text</pdfaProperty:valueType>
                        </rdf:li>
                        <rdf:li rdf:parseType="Resource">
                           <pdfaProperty:category>internal</pdfaProperty:category>
                           <pdfaProperty:description>Software by which the profile was created</pdfaProperty:description>
                           <pdfaProperty:name>profile_creator</pdfaProperty:name>
                           <pdfaProperty:valueType>Text</pdfaProperty:valueType>
                        </rdf:li>
                        <rdf:li rdf:parseType="Resource">
                           <pdfaProperty:category>internal</pdfaProperty:category>
                           <pdfaProperty:description>The version number of the software used for creating the profile</pdfaProperty:description>
                           <pdfaProperty:name>profile_creator_version</pdfaProperty:name>
                           <pdfaProperty:valueType>Text</pdfaProperty:valueType>
                        </rdf:li>
                        <rdf:li rdf:parseType="Resource">
                           <pdfaProperty:category>internal</pdfaProperty:category>
                           <pdfaProperty:description>The version number of the format in which the profile was stored</pdfaProperty:description>
                           <pdfaProperty:name>profile_format_version</pdfaProperty:name>
                           <pdfaProperty:valueType>Text</pdfaProperty:valueType>
                        </rdf:li>
                        <rdf:li rdf:parseType="Resource">
                           <pdfaProperty:category>internal</pdfaProperty:category>
                           <pdfaProperty:description>Result of executing the profile, with four possible values "Errors", "Warnings", "Info" or "Success" (severity in decreasing order; highest severity found in the preflight check must be reported here)</pdfaProperty:description>
                           <pdfaProperty:name>preflight_results</pdfaProperty:name>
                           <pdfaProperty:valueType>Closed Choice of Text</pdfaProperty:valueType>
                        </rdf:li>
                        <rdf:li rdf:parseType="Resource">
                           <pdfaProperty:category>internal</pdfaProperty:category>
                           <pdfaProperty:description>An optional entry with descriptive text about the errors if any (actual implementation is at the discretion of the software creating the audit trail)</pdfaProperty:description>
                           <pdfaProperty:name>preflight_results_description</pdfaProperty:name>
                           <pdfaProperty:valueType>Text</pdfaProperty:valueType>
                        </rdf:li>
                        <rdf:li rdf:parseType="Resource">
                           <pdfaProperty:category>internal</pdfaProperty:category>
                           <pdfaProperty:description>Date and time when the profile was executed</pdfaProperty:description>
