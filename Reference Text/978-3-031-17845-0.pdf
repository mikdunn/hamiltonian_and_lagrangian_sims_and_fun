                           <pdfaProperty:valueType>Date</pdfaProperty:valueType>
                        </rdf:li>
                        <rdf:li rdf:parseType="Resource">
                           <pdfaProperty:category>internal</pdfaProperty:category>
                           <pdfaProperty:description>A fingerprint for the profile that was used to carry out the preflight check</pdfaProperty:description>
                           <pdfaProperty:name>profile_fingerprint</pdfaProperty:name>
                           <pdfaProperty:valueType>Text</pdfaProperty:valueType>
                        </rdf:li>
